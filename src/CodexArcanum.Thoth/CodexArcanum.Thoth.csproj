<!-- src/CodexArcanum.Thoth/CodexArcanum.Thoth.csproj -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Configurações para dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>codex-thoth</ToolCommandName>
    <PackageId>CodexArcanum.Thoth</PackageId>
    <Version>0.1.4.1</Version>
    <Authors>Luís Gabriel N. Simas</Authors>
    <Description>CLI de indexação e diagnóstico de codebase .NET</Description>
    <PackageOutputPath>./nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodexArcanum.Smaragdus\CodexArcanum.Smaragdus.csproj" />
  </ItemGroup>
</Project>